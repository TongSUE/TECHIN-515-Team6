import { initializeApp } from 'firebase/app';
import { getDatabase } from 'firebase/database';

// Copy this file to firebase.js and fill in your values from:
// Firebase Console → aurasync-team6 → Project Settings → General → Your apps → Web app → Config
const firebaseConfig = {
  apiKey: "YOUR_API_KEY",
  authDomain: "aurasync-team6.firebaseapp.com",
  databaseURL: "https://aurasync-team6-default-rtdb.firebaseio.com",
  projectId: "aurasync-team6",
  storageBucket: "aurasync-team6.firebasestorage.app",
  messagingSenderId: "YOUR_SENDER_ID",
  appId: "YOUR_APP_ID"
};

const app = initializeApp(firebaseConfig);
export const db = getDatabase(app);
